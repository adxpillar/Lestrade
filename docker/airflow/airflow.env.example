# Airflow container user id (Linux). On macOS it’s not strictly required,
# but keeping it avoids permission issues for logs/volumes across hosts.
AIRFLOW_UID=50000

# Airflow UI admin user (created by `airflow-init`)
AIRFLOW_ADMIN_USERNAME=change_me
AIRFLOW_ADMIN_PASSWORD=change_me_to_a_strong_password
AIRFLOW_ADMIN_EMAIL=admin@example.com

# Password for the local Airflow metadata Postgres (service `airflow-db`).
# Required (no default) to avoid accidentally committing weak credentials.
AIRFLOW_DB_PASSWORD=change_me_to_a_strong_password

# Lestrade / EDGAR config
EDGAR_APP_NAME=Lestrade
EDGAR_CONTACT_EMAIL=you@example.com

# Store raw XML in the Postgres BYTEA column for local/dev.
# For object storage later, set to "s3" and configure LESTRADE_S3_BUCKET + boto3 creds.
LESTRADE_RAW_STORAGE=bytea

# Optional: override Airflow connection id used by dags/ (defaults to "lestrade_rds")
# LESTRADE_PG_CONN=lestrade_rds

# Universe: trading session date (ISO) — must match Barchart filenames MM-DD-YYYY suffix.
# LESTRADE_UNIVERSE_TRADING_DATE=2026-05-06

# Optional: folder containing Barchart highs/lows CSV exports (Compose default sees repo-root folder).
# LESTRADE_BARCHART_DIR=/opt/airflow/lestrade/barchart_report_today

# Optional: where to archive processed Barchart CSVs after universe_snapshot succeeds.
# LESTRADE_BARCHART_ARCHIVE_DIR=/opt/airflow/lestrade/barchart_report_archive

# Entrant backfill lookback (calendar days); DAG edgar_backfill_on_entry — default 365 if unset.
# LESTRADE_ENTRY_BACKFILL_DAYS=365
# Entrant backfill Airflow task timeout (hours); default 6 in DAG if unset.
# LESTRADE_ENTRY_BACKFILL_TIMEOUT_HOURS=12

# Phase 2 Stooq daily prices — API key from captcha flow on stooq.com (see enrich_universe_market_context).
# LESTRADE_STOOQ_APIKEY=

# Market enrichment DAG task timeout (hours); default 8 if unset. Large universes + full history need headroom.
# LESTRADE_ENRICH_MARKET_TIMEOUT_HOURS=8

# Phase 2 Yahoo Finance issuer profile — DAG enrich_universe_company_profile (see docs/PHASE2_DATA.md).
# LESTRADE_ENRICH_PROFILE_TIMEOUT_HOURS=4
# LESTRADE_YFINANCE_SLEEP_S=0.35
# LESTRADE_YFINANCE_TIMEOUT_S=25

# Phase 2 SEC issuer profile (submissions JSON) — DAG enrich_issuer_sec_profile (see docs/PHASE2_DATA.md).
# LESTRADE_ISSUER_SEC_SCOPE=universe
# LESTRADE_ISSUER_SEC_SECURITY_MASTER_LIMIT=500
# LESTRADE_ENRICH_ISSUER_SEC_TIMEOUT_HOURS=4

# Phase 3 embeddings — DAG embed_form4_transactions (see docs/PHASE3_ARCHITECTURE.md).
# LESTRADE_CHROMA_PERSIST_DIR=/opt/airflow/chroma
# LESTRADE_EMBED_TRADING_DATES=2026-05-14,2026-05-15
# LESTRADE_EMBED_BATCH_SIZE=32
# LESTRADE_EMBED_TIMEOUT_HOURS=4
# VOYAGE_API_KEY=

# Recommended: set the PostgresHook connection to Supabase via env var instead of clicking UI.
# Format:
#   postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
#
# Example (do not commit real creds):
# AIRFLOW_CONN_LESTRADE_RDS=postgresql://postgres:YOUR_PASSWORD@db.<ref>.supabase.co:5432/postgres?sslmode=require

