# Airflow container user id (Linux). On macOS it’s not strictly required,
# but keeping it avoids permission issues for logs/volumes across hosts.
AIRFLOW_UID=50000

# Airflow UI admin user (created by `airflow-init`)
AIRFLOW_ADMIN_USERNAME=change_me
AIRFLOW_ADMIN_PASSWORD=change_me_to_a_strong_password
AIRFLOW_ADMIN_EMAIL=admin@example.com

# Password for the local Airflow metadata Postgres (service `airflow-db`).
# Required (no default) to avoid accidentally committing weak credentials.
AIRFLOW_DB_PASSWORD=change_me_to_a_strong_password

# Lestrade / EDGAR config
EDGAR_APP_NAME=Lestrade
EDGAR_CONTACT_EMAIL=you@example.com

# Store raw XML in the Postgres BYTEA column for local/dev.
# For object storage later, set to "s3" and configure LESTRADE_S3_BUCKET + boto3 creds.
LESTRADE_RAW_STORAGE=bytea

# Optional: override Airflow connection id used by dags/ (defaults to "lestrade_rds")
# LESTRADE_PG_CONN=lestrade_rds

# Recommended: set the PostgresHook connection to Supabase via env var instead of clicking UI.
# Format:
#   postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
#
# Example (do not commit real creds):
# AIRFLOW_CONN_LESTRADE_RDS=postgresql://postgres:YOUR_PASSWORD@db.<ref>.supabase.co:5432/postgres?sslmode=require

